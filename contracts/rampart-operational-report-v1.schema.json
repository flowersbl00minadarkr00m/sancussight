{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sancussight.local/contracts/rampart-operational-report-v1.schema.json",
  "title": "RampartOperationalReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceVersion", "runId", "targetId", "suiteVersion", "evaluatorVersion", "results"],
  "properties": {
    "schemaVersion": { "const": 1 }, "sourceVersion": { "type": "string", "maxLength": 80 }, "runId": { "type": "string", "maxLength": 160 }, "targetId": { "type": "string", "maxLength": 160 }, "suiteVersion": { "type": "string", "maxLength": 80 }, "evaluatorVersion": { "type": "string", "maxLength": 80 },
    "results": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/result" } },
    "operational": { "type": "object" }
  },
  "$defs": {
    "result": { "type": "object", "additionalProperties": false, "required": ["resultId", "scenarioId", "status", "summary", "observedAt"], "properties": {
      "resultId": { "type": "string", "maxLength": 160 }, "scenarioId": { "type": "string", "maxLength": 160 }, "status": { "enum": ["safe", "unsafe", "undetermined", "error"] }, "safe": { "type": "boolean" }, "summary": { "type": "string", "maxLength": 320 }, "harmCategory": { "type": "string", "maxLength": 80 }, "strategy": { "type": "string", "maxLength": 160 }, "durationMs": { "type": "number", "minimum": 0 }, "observedAt": { "type": "string", "format": "date-time" }
    } }
  }
}
