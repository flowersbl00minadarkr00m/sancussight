{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sancussight.local/contracts/release-run-descriptor-v1.schema.json",
  "title": "SancusSight release run descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseRunId",
    "startedAt",
    "runtimeTargetId",
    "purpose"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,160}$"
    },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "runtimeTargetId": {
      "const": "sancussight-local-runtimes"
    },
    "purpose": {
      "const": "a002-t16"
    }
  }
}
